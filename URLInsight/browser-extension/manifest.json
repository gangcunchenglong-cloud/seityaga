{
  "manifest_version": 3,
  "name": "URL Insight / LinkLens",
  "version": "1.5.0",
  "description": "リンクにカーソルを合わせると、Windowsアプリ「URL Insight」がリンク先の要約カードを表示します。",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "storage", "scripting", "activeTab"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "URL Insight",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
