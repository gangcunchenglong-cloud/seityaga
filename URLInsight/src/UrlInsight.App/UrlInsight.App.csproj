<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>URLInsight</AssemblyName>
    <RootNamespace>UrlInsight.App</RootNamespace>
    <StartupObject>UrlInsight.App.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 配布設定: win-x64 向け自己完結型・単一ファイル(.NET ランタイムのインストール不要) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
    <!-- WinForms は NotifyIcon(トレイ)と Screen のためだけに使う -->
    <NoWarn>$(NoWarn);CA1416;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app256.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UrlInsight.Core\UrlInsight.Core.csproj" />
    <!-- UI オートメーション COM 版(UIA3)の .NET 用インターフェイス定義(MIT) -->
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
  </ItemGroup>

</Project>
