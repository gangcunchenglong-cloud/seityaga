{
  "name": "quiz-hiroba",
  "version": "1.0.0",
  "description": "クイズひろば（理科・算数・社会・歴史）",
  "author": "seityaga",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.seityaga.quizhiroba",
    "productName": "クイズひろば",
    "files": ["main.js", "app/**/*"],
    "directories": { "output": "dist" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "QuizHiroba-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "クイズひろば"
    }
  }
}
